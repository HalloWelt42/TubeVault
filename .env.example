# TubeVault: Ordner und Adressen des Betriebs. Kopieren nach .env neben docker-compose.yml und anpassen;
# die .env bleibt außerhalb des Repos. Ohne die Pflichtangaben startet docker compose nicht.

# Index auf schneller Platte: data (Datenbank), thumbnails, avatars, metadata, banners, nachvertoner
TUBEVAULT_INDEX=/srv/tubevault
# Medien auf großer Platte: videos, audio, subtitles, exports (darin backups, die Sicherungen der Datenbank)
TUBEVAULT_MEDIEN=/mnt/platte/tubevault

# Wahlweise, beide nur lesend: alte Videos für "Eigene Videos" und die eigene Musiksammlung
# TUBEVAULT_SCAN_SOURCE=/mnt/platte/alte-videos
# TUBEVAULT_MUSIC_SOURCE=/mnt/platte/musik

# Nachvertoner: Datei mit dem App-Schlüssel der Kellerwolke (Modus 0600), Zertifikat der Hausstelle der Vertonung,
# Adressen von Vertonung und Kellerwolke
NACHVERTONER_SCHLUESSEL=/home/benutzer/.nachvertoner_schluessel
NACHVERTONER_CA=/srv/vertonung/zertifikate/rootCA.pem
NACHVERTONER_VERTONUNG=https://192.168.1.20:8641
NACHVERTONER_KELLERWOLKE=http://192.168.1.20:39278
